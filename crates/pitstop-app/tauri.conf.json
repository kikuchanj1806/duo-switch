{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duo Switch",
  "identifier": "io.github.kikuchanj1806.duoswitch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Duo Switch",
        "width": 860,
        "height": 640,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "DeveloperTool",
    "publisher": "Tunglx",
    "copyright": "Copyright (c) 2026 Tunglx. Portions Copyright (c) 2026 Benpiaz. MIT with the Commons Clause.",
    "homepage": "https://github.com/kikuchanj1806/duo-switch",
    "license": "LicenseRef-MIT-Commons-Clause",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Switch Claude Desktop profiles and Codex accounts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyOTdFN0RDRUNEOEEyNjgKUldSb290anMzT2VYZ29JZU0vUGlBR0F1K1FaM3lYME01Nzl1TG1Oa1c2NFBCOThXYXYrdldabjgK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/kikuchanj1806/duo-switch/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
